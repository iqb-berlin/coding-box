{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "prefix": "coding-box",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath.base}"
      ],
      "options": {
        "allowedCommonJsDependencies": [
          "xml2js",
          "base64-js",
          "js-sha256",
          "exceljs",
          "@iqbspecs/response",
          "@iqbspecs/response/response.interface",
          "@iqb/metadata/md-profile-entry",
          "@iqb/metadata",
          "@iqb/metadata-components"
        ],
        "outputPath": {
          "base": "dist/apps/frontend",
          "browser": ""
        },
        "index": "apps/frontend/src/index.html",
        "polyfills": [],
        "tsConfig": "apps/frontend/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/frontend/src/assets"
        ],
        "styles": [
          "./node_modules/@angular/material/prebuilt-themes/purple-green.css",
          "apps/frontend/src/styles.scss"
        ],
        "scripts": [],
        "browser": "apps/frontend/src/main.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "50kb",
              "maximumError": "100kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/frontend/src/environments/environment.ts",
              "with": "apps/frontend/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "frontend:build:production"
        },
        "development": {
          "buildTarget": "frontend:build:development"
        }
      },
      "options": {
        "proxyConfig": "apps/frontend/proxy.conf.json",
        "buildTarget": "frontend:build:development"
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "frontend:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/frontend/src/**/*.ts",
          "apps/frontend/src/**/*.html"
        ],
        "maxWarnings": 0
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/apps/frontend"
      ],
      "options": {
        "jestConfig": "apps/frontend/jest.config.ts",
        "passWithNoTests": false
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "e2e": {
      "executor": "@nx/cypress:cypress",
      "inputs": [
        "default",
        "^production",
        "frontendE2e",
        "{workspaceRoot}/scripts/qa/hash-frontend-artifact.mjs",
        {
          "runtime": "node scripts/qa/hash-frontend-artifact.mjs"
        }
      ],
      "options": {
        "cypressConfig": "cypress.config.ts",
        "testingType": "e2e",
        "devServerTarget": "frontend:serve"
      },
      "configurations": {
        "production": {
          "devServerTarget": "frontend:serve:production"
        },
        "ci": {
          "devServerTarget": "frontend:serve-static"
        }
      }
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "frontendE2e"
      ],
      "outputs": [
        "{workspaceRoot}/cypress/component-screenshots",
        "{workspaceRoot}/cypress/component-videos"
      ],
      "options": {
        "cypressConfig": "cypress.config.ts",
        "testingType": "component",
        "devServerTarget": "frontend:build",
        "skipServe": true
      }
    },
    "test-quality-gates": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/qa/frontend-quality-gates.test.mjs"
      }
    },
    "test-dependency-patches": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/qa/dependency-patches.test.mjs"
      }
    },
    "test-e2e-harness": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/e2e/replay/loopback-forwarders.test.mjs"
      }
    },
    "e2e-replay-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/e2e/replay/run-replay-e2e.mjs"
      },
      "configurations": {
        "production": {
          "command": "node scripts/e2e/replay/run-replay-e2e.mjs --production"
        }
      }
    },
    "e2e-replay-existing": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/e2e/replay/run-existing-replay-e2e.mjs"
      }
    },
    "e2e-auth-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/e2e/replay/run-replay-e2e.mjs --auth"
      },
      "configurations": {
        "production": {
          "command": "node scripts/e2e/replay/run-replay-e2e.mjs --auth --production"
        }
      }
    },
    "zoneless-inventory": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/qa/zoneless-inventory.mjs"
      }
    },
    "zoneless-approval": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/qa/zoneless-inventory.mjs --require-risk-coverage"
      }
    },
    "zoneless-exhaustive-approval": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/qa/zoneless-inventory.mjs --require-complete"
      }
    },
    "zoneless-inventory-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/qa/zoneless-inventory.test.mjs"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "continuous": true,
      "cache": false,
      "options": {
        "staticFilePath": "dist/apps/frontend",
        "watch": false,
        "spa": true,
        "host": "127.0.0.1",
        "port": 4200
      }
    }
  }
}
