{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "schemas",
            "output": "schemas"
          }
        ],
        "webpackConfig": "apps/backend/webpack.config.js",
        "outputPath": "dist/apps/backend",
        "main": "apps/backend/src/main.ts",
        "tsConfig": "apps/backend/tsconfig.app.json",
        "generatePackageJson": true,
        "target": "node",
        "compiler": "tsc"
      },
      "configurations": {
        "production": {
          "optimization": false,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/backend/src/environments/environment.ts",
              "with": "apps/backend/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "backend:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/backend/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/apps/backend"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.config.ts",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/docs/workspace-api-token-rights-de.md",
        "{workspaceRoot}/docs/workspace-api-token-rights.md",
        "{workspaceRoot}/scripts/qa/**/*",
        "{workspaceRoot}/database/changelog/**/*",
        "{workspaceRoot}/scripts/reference/variable-analysis-eatpreptba/**/*",
        { "env": "BULLMQ_TEST_REDIS_HOST" },
        { "env": "BULLMQ_TEST_REDIS_PORT" },
        { "env": "KAPPA_QUERY_TEST_DATABASE_URL" },
        { "env": "POSTGRES_INTEGRATION_TESTS" },
        { "env": "POSTGRES_HOST" },
        { "env": "POSTGRES_PORT" },
        { "env": "POSTGRES_USER" },
        { "env": "POSTGRES_PASSWORD" },
        { "env": "POSTGRES_DB" },
        { "env": "REDIS_HOST" },
        { "env": "REDIS_PORT" },
        { "env": "REDIS_PREFIX" },
        { "env": "WORKSPACE_DELETION_TEST_DATABASE_URL" },
        { "env": "PSQL_BIN" },
        { "env": "KAPPA_QUERY_BENCHMARK" },
        { "env": "KAPPA_QUERY_BENCHMARK_OUTPUT" }
      ],
      "options": {
        "command": "node scripts/qa/run-backend-jest.mjs"
      },
      "configurations": {
        "ci": {
          "command": "node scripts/qa/run-backend-jest.mjs --configuration=ci"
        }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker login {args.registry}",
            "forwardAllArgs": false
          },
          "docker build -f apps/backend/Dockerfile --build-arg project=backend --target=prod -t {args.registry}{args.registryProject}iqbberlin/coding-box-backend:{args.tag} -t {args.registry}{args.registryProject}iqbberlin/coding-box-backend:latest .",
          "docker push -q -a {args.registry}{args.registryProject}iqbberlin/coding-box-backend"
        ],
        "parallel": false
      }
    },
    "docker-scan": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker pull {args.registry}{args.registryProject}iqbberlin/coding-box-backend:{args.tag}",
          "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v $HOME/Library/Caches:/root/.cache/ aquasec/trivy:0.29.2 image --exit-code 1 --scanners vuln --ignore-unfixed --severity CRITICAL {args.registry}{args.registryProject}iqbberlin/coding-box-backend:{args.tag}"
        ]
      }
    },
    "verify-runtime-package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/qa/verify-backend-runtime-package.mjs"
      },
      "configurations": {
        "smoke": {
          "command": "node scripts/qa/verify-backend-runtime-package.mjs --smoke"
        }
      }
    },
    "verify-codebook-autocoder-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/e2e/codebook/verify-live.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node --test scripts/quality/check-backend-strict.test.mjs",
          "node scripts/quality/check-backend-strict.mjs",
          "node scripts/quality/check-entity-metadata.cjs"
        ],
        "parallel": false
      }
    },
    "verify-item-matrix-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/e2e/item-matrix/verify-live.mjs"
      }
    },
    "verify-hardening-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/e2e/backend-hardening/verify-runtime.mjs"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node --test scripts/qa/run-backend-integration.test.mjs",
          "node scripts/qa/run-backend-integration.mjs"
        ],
        "parallel": false
      }
    },
    "verify-bullmq-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/qa/run-bullmq-integration.mjs"
      },
      "configurations": {
        "full": {
          "command": "node scripts/qa/run-bullmq-integration.mjs --all"
        }
      }
    },
    "test-jest": {
      "executor": "@nx/jest:jest",
      "cache": false,
      "options": {
        "jestConfig": "apps/backend/jest.config.ts",
        "passWithNoTests": false
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
